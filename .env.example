# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example

# URL API афиши событий
FEED_URL=https://www.ashgabatevents.com/api/public/v1/events

# Часовой пояс (по умолчанию Asia/Ashgabat)
TIMEZONE_NAME=Asia/Ashgabat

# Время утренней рассылки дайджеста (формат HH:MM в локальном часовом поясе)
DIGEST_TIME=09:00

# Время жизни кэша событий в секундах
FEED_TTL_SECONDS=300

# Путь к файлу базы данных SQLite
DB_PATH=data/bot.sqlite3

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Прокси (необязательно, например: http://user:pass@host:port)
# PROXY_URL=